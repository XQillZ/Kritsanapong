{
  "expo": {
    "name": "AI Guess Game",
    "slug": "guessing-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gameend",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#06111F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.guessinggame"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06111F"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.yourcompany.guessinggame"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#06111F"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#06111F"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "940fb181-dd4a-4b0b-9c3c-2ea34df3ba60"
      }
    }
  }
}
